        "jsCode": "const body = $json.body ?? $json;\nif (!body.task_id || !body.claim_id || String(body.task_type ?? '').toUpperCase() !== 'DENIAL_REVIEW') {\n  return [{ json: { status: 'ERROR', error_type: 'INVALID_INPUT', message: 'task_id, claim_id, and DENIAL_REVIEW are required', task_id: body.task_id ?? null, claim_id: body.claim_id ?? null } }];\n}\nreturn [{ json: { ...body, task_type: 'DENIAL_REVIEW' } }];"
      },
      "id": "validate",
