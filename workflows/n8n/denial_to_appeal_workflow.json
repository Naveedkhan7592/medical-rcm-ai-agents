    },
    {
      "parameters": {
        "jsCode": "const result = $json.body ?? $json;\nconst required = ['task_id','claim_id','status','next_action','human_review_required'];\nconst missing = required.filter((key) => result[key] === undefined || result[key] === null);\nif (missing.length) {\n  return [{ json: { status: 'ERROR', error_type: 'MALFORMED_SUPERVISOR_RESPONSE', message: `Missing response field(s): ${missing.join(', ')}`, task_id: result.task_id ?? null, claim_id: result.claim_id ?? null } }];\n}\nconst appealRoute = result.human_review_required === true || String(result.status ?? '').toUpperCase() === 'REVIEW' || String(result.status ?? '').toUpperCase() === 'WAITING'\n  ? 'HUMAN_REVIEW'\n  : (String(result.status ?? '').toUpperCase() === 'COMPLETED' && String(result.next_action ?? '').toUpperCase() !== 'HUMAN_REVIEW' ? 'PREPARE_FOR_HUMAN_REVIEW' : 'HUMAN_REVIEW');\nreturn [{ json: { ...result, appeal_route: appealRoute, external_submission_allowed: false, human_review_required: Boolean(result.human_review_required) } }];"
      },
